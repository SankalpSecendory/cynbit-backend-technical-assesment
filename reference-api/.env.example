# Application Environment Configuration
NODE_ENV=development
PORT=3000

# Database Connection (SQLite for zero-config portable testing; use PostgreSQL in production)
# SQLite: file:./dev.db
# PostgreSQL: postgresql://postgres:postgres@localhost:5432/cynbit_inquiries?schema=public
DATABASE_URL="file:./dev.db"

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGIN="https://www.cynbit.in,http://localhost:3000"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# Administrative Authentication Key for Protected Endpoints
ADMIN_API_KEY="cynbit_test_admin_secret_key_2026"
