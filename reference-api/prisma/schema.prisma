// Cynbit Inquiry Management System — Prisma Schema
// Note: For portable zero-dependency testing and local developer runs, 
// this schema defaults to SQLite. For production deployment on PostgreSQL, 
// switch provider to "postgresql" and use the documented PostgreSQL connection string.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// In production on PostgreSQL:
// datasource db {
//   provider = "postgresql"
//   url      = env("DATABASE_URL")
// }

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  industry  String?
  message   String
  status    String   @default("RECEIVED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}
